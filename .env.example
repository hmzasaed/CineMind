# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ──────────────────────────────────────────────────
# Production backend verifies Supabase access tokens against the project's
# JWKS endpoint (SUPABASE_URL). For local dev/tests without a Supabase project,
# set JWT_SECRET (>= 24 chars) and the backend verifies HS256 tokens instead.
JWT_SECRET=

# ── Backend ───────────────────────────────────────────────
BACKEND_PORT=3000
BACKEND_LOG_LEVEL=info
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=*                      # * or a comma-separated list of origins
MOVIE_PROVIDER=mock              # mock | tmdb
TMDB_API_KEY=                    # only needed when MOVIE_PROVIDER=tmdb

# ── AI Service ─────────────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=info
AI_SERVICE_RATE_LIMIT=30;minute
LLM_PROVIDER=rule-based          # rule-based | openai | groq | mistral | gemini
CINEMIND_BACKEND_BASE_URL=http://localhost:3000

# Free LLM keys (only the one matching LLM_PROVIDER is required):
#GROQ_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile
#MISTRAL_API_KEY=
#MISTRAL_MODEL=open-mistral-nemo-2407
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.0-flash

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
# Public Supabase project URL + anon key (safe for the browser bundle; the
# service-role key and provider API keys are backend-only).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_AI_SERVICE_URL=http://localhost:8000