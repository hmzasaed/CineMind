# Movie fact lookups must be trimmed with the AI service URL and underlying source.
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=info
AI_SERVICE_RATE_LIMIT=30;minute

# Base URL of the CineMind backend (structured facts API). Required.
CINEMIND_BACKEND_BASE_URL=http://localhost:3000

# LLM provider behind the interface. One of: rule-based | openai
# rule-based is a deterministic, offline provider for tests/dev. It is NOT an LLM.
LLM_PROVIDER=rule-based

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Timeout for provider calls (seconds) and for backend fact lookups (seconds).
PROVIDER_TIMEOUT_SECONDS=30
BACKEND_TIMEOUT_SECONDS=10