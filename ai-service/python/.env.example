# Movie fact lookups go through the CineMind backend (structured facts API).
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=info
AI_SERVICE_RATE_LIMIT=30;minute

# Base URL of the CineMind backend (structured facts API). Required.
CINEMIND_BACKEND_BASE_URL=http://localhost:3000

# ── LLM provider (behind the interface). One of:
#    rule-based | openai | groq | mistral | gemini
# rule-based is a deterministic, offline provider for tests/dev. It is NOT an LLM.
LLM_PROVIDER=rule-based

# ── Free providers ─────────────────────────────────────────
# Each needs only its own key. The model defaults are popular free-tier models;
# check the provider console for the current free list before deployment.

# Groq (free tier) — https://console.groq.com  key looks like gsk_...
#GROQ_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile

# Mistral (free tier) — https://console.mistral.ai
#MISTRAL_API_KEY=
#MISTRAL_MODEL=open-mistral-nemo-2407

# Google Gemini (free tier) — https://aistudio.google.com/apikey
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.0-flash

# ── Paid alternative ───────────────────────────────────────
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# Timeouts (seconds)
PROVIDER_TIMEOUT_SECONDS=30
BACKEND_TIMEOUT_SECONDS=10