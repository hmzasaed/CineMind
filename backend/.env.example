# Backend specific environment. Values here override the root .env.example.
BACKEND_PORT=3000
BACKEND_LOG_LEVEL=info
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# JWT secret for issuing/verifying API tokens. MUST be set in production.
JWT_SECRET=

# Movie data source. One of: tmdb | mock
MOVIE_PROVIDER=mock

# Only needed when MOVIE_PROVIDER=tmdb
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3