# Values prefixed with VITE_ are bundled into the browser build.
# NEVER put secrets here; the browser bundle is public.
VITE_API_BASE_URL=http://localhost:3000

# Public Supabase project URL + anon key. Safe to expose: Supabase Auth and
# RLS are designed for browser use. The service-role key lives only in the
# backend/.env file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=